{
  "name": "stunks",
  "private": true,
  "version": "0.1.0",
  "description": "Stunks: simulador de trading con replay. ¿Ventaja o suerte?",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:archivo": "tsc --noEmit && vite build --mode archivo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:practica": "tsc --noEmit && vite build --mode practica",
    "probar:motor": "node --experimental-strip-types herramientas/probar-motor.ts practica/datos/nq/m practica/pruebas/prueba_motor_js.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "biome ci . && tsc --noEmit && vitest run && vite build",
    "db:iniciar": "supabase start -x studio,imgproxy,postgres-meta,edge-runtime,logflare,vector,supavisor",
    "db:parar": "supabase stop",
    "db:reiniciar": "supabase db reset",
    "db:probar": "supabase test db && supabase db lint --fail-on warning",
    "db:tipos": "supabase gen types typescript --schema public > src/cuenta/tipos-db.ts && biome format --write src/cuenta/tipos-db.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "supabase": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
